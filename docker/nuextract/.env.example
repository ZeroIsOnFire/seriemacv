# Leave empty to download the official NuExtract3 Q4_K_M GGUF into the Docker volume.
# To use a host file instead, put it under docker/nuextract/models/ and set, e.g.:
# NUEXTRACT_GGUF_PATH=/external/my-nuextract.gguf
# NUEXTRACT_GGUF_PATH=
# Optional override for a reviewed compatible GGUF URL.
# NUEXTRACT_GGUF_URL=https://huggingface.co/numind/NuExtract3-GGUF/resolve/main/NuExtract3-Q4_K_M.gguf
NUEXTRACT_PORT=8080
NUEXTRACT_CONTEXT_SIZE=8192
# CPU default. Set a positive value only with a GPU-enabled llama.cpp image/runtime.
NUEXTRACT_GPU_LAYERS=0
